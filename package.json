{
  "name": "go-turbo",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-driven Go performance engineering skills for coding agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/hendriknielaender/go-turbo"
  },
