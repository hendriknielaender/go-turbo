{
  "listen_addr": "0.0.0.0:8443",
  "database_url": "postgres://svc:secret@db.internal:5432/app?sslmode=require",
  "region": "US-EAST-1",
  "feature_flags": {
    "NewCheckout": true,
    "DarkMode": false,
    "BetaSearch": true,
    "LegacyExport": false,
    "InlineHelp": true,
    "FastPath": true,
    "AuditLogV2": false,
    "RateLimitV3": true
